__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# ...but its README explains where the binaries went, and a collaborator who
# clones the repository needs to be able to read that.
!dist/
dist/*
!dist/README.md
.pytest_cache/
.venv/
venv/

# FACET's own build output and user data
/licenses/
# proto renders are kept: they are the evidence the renderer works
*.spec
facet_settings.json

# Built binaries. dist/README.md is tracked; the artefacts are not --
# FACET-Setup-0.1.0.exe is 146 MB and GitHub rejects anything over 100 MB.
# Binaries belong in a GitHub Release, which allows 2 GB per file.
/dist/*
!/dist/README.md
/assets/*.ico
